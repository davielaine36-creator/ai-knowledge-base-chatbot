# ---------------------------------------------------------------------------
# AI Knowledge Base Chatbot — environment variables
# Copy this file to `.env.local` and fill in your values.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Required: your OpenAI API key. Used for both embeddings and chat completions.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: the chat model used to generate answers.
# Defaults to gpt-4o-mini (fast + inexpensive, great for demos).
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: the embedding model used for the knowledge base + questions.
# Must be the SAME model used when generating the vector index.
# Defaults to text-embedding-3-small (1536 dims — matches the Supabase schema).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Supabase (pgvector) — OPTIONAL
# If SUPABASE_URL and SUPABASE_ANON_KEY are set, the app retrieves from
# Supabase instead of the local data/vector-index.json file. If they are NOT
# set, the app falls back to the local index (run `npm run embeddings`).
# ---------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Publishable / anon key (safe to expose). The app reads through a
# SECURITY DEFINER function, so the anon key is all the runtime needs.
SUPABASE_ANON_KEY=

# Service-role key (SECRET) — only needed locally to SEED the database with
# `npm run seed:supabase`. Never deploy this to the client/runtime.
# Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
